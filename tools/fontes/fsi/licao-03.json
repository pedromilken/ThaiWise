{"n": 3, "paginas": "vol. 1, p. 20–34",
 "titulo": {"pt": "Identificando objetos", "en": "Identifying objects"},
 "dialogo": [
  {"sp": "A", "s": "คุณ|kun มี|mii แผนที่|pɛ̌ɛn-tîi ไหม|mǎi ครับ|kráp", "fsi": "khun mii phɛ̌ɛnthîi máj khráp", "en": "Do you have a map?", "pt": "Você tem um mapa?"},
  {"sp": "B", "s": "มี|mii ครับ|kráp", "fsi": "mii khráp", "en": "I do.", "pt": "Tenho."},
  {"sp": "A", "s": "ดี|dii ไหม|mǎi ครับ|kráp", "fsi": "dii máj khráp", "en": "Is it good?", "pt": "É bom?"},
  {"sp": "B", "s": "ดี|dii ครับ|kráp", "fsi": "dii khráp", "en": "It's good.", "pt": "É bom."},
  {"sp": "A", "s": "นี่|nîi อะไร|à-rai ครับ|kráp", "fsi": "nîi ʔaraj khráp", "en": "What's this?", "pt": "O que é isto?"},
  {"sp": "B", "s": "นั่น|nân รูป|rûup ครับ|kráp", "fsi": "nân rûup khráp", "en": "That's a picture.", "pt": "Isso é uma figura."},
  {"sp": "A", "s": "รูป|rûup อะไร|à-rai ครับ|kráp", "fsi": "rûup ʔaraj khráp", "en": "A picture of what?", "pt": "Figura de quê?"},
  {"sp": "B", "s": "รูป|rûup วัด|wát ครับ|kráp", "fsi": "rûup wát khráp", "en": "A picture of a temple.", "pt": "De um templo."},
  {"sp": "A", "s": "สวย|sǔuai ไหม|mǎi ครับ|kráp", "fsi": "sǔaj máj khráp", "en": "Is it pretty?", "pt": "É bonita?"},
  {"sp": "B", "s": "สวย|sǔuai ครับ|kráp", "fsi": "sǔaj khráp", "en": "It's pretty.", "pt": "É bonita."},
  {"sp": "A", "s": "แล้ว|lɛ́ɛo นี่|nîi เรียกว่า|rîiak-wâa อะไร|à-rai ครับ|kráp", "fsi": "lɛ́ɛw nîi rîak wâa ʔaraj khráp", "en": "And what's this called?", "pt": "E isto, como se chama?"},
  {"sp": "B", "s": "เรียกว่า|rîiak-wâa หน้าต่าง|nâa-dtàang ครับ|kráp", "fsi": "rîak wâa nâatàaŋ khráp", "en": "It's called a 'window'.", "pt": "Chama-se 'janela'."},
  {"sp": "A", "s": "ขอโทษ|kɔ̌ɔ-tôot อย่า|yàa เปิด|bpə̀ət หน้าต่าง|nâa-dtàang ครับ|kráp", "fsi": "khɔ̌ɔthôot, jàa pə̀ət nâatàaŋ khráp", "en": "Excuse me. Don't open the window.", "pt": "Com licença. Não abra a janela."},
  {"sp": "B", "s": "ขอโทษ|kɔ̌ɔ-tôot คุณ|kun พูด|pûut ว่า|wâa อะไร|à-rai ครับ|kráp", "fsi": "khɔ̌ɔthôot, khun phûut wâa ʔaraj khráp", "en": "Excuse me. What did you say?", "pt": "Desculpe, o que você disse?"},
  {"sp": "B", "s": "ผม|pǒm ไม่|mâi เข้าใจ|kâo-jai", "fsi": "phǒm mâj khâwcaj", "en": "I didn't understand.", "pt": "Não entendi."},
  {"sp": "B", "s": "กรุณา|gà-rú-naa พูด|pûut ช้าๆ|cháa-cháa หน่อย|nɔ̀i ได้|dâai ไหม|mǎi ครับ|kráp", "fsi": "karunaa phûut cháa cháa nɔ̀j, dâj máj khráp", "en": "Could you please speak slowly?", "pt": "Poderia falar devagar, por favor?"},
  {"sp": "A", "s": "ผม|pǒm พูด|pûut ว่า|wâa อย่า|yàa เปิด|bpə̀ət หน้าต่าง|nâa-dtàang", "fsi": "phǒm phûut wâa jàa pə̀ət nâatàaŋ", "en": "I said, 'Don't open the window.'", "pt": "Eu disse: 'Não abra a janela.'"}
 ],
