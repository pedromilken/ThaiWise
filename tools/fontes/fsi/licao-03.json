 "notas": [
  {"t": {"pt": "นี่, นั่น, โน่น: perto, meio e longe", "en": "นี่, นั่น, โน่น: near, middle, far"}, "e": {"pt": "นี่ = isto (perto de quem fala); นั่น = isso (perto de quem ouve ou já mencionado); โน่น = aquilo lá longe. Sem verbo 'ser': นี่อะไร = 'isto o quê?'. Analogia: três degraus de distância, como 'aqui, aí, lá'.", "en": "นี่ this (near the speaker), นั่น that (near the listener), โน่น that over there. No verb 'to be': นี่อะไร."}, "ex": "นี่|nîi อะไร|à-rai"},
  {"t": {"pt": "Adjetivo é verbo", "en": "Adjectives are verbs"}, "e": {"pt": "สวย (bonito) e ดี (bom) funcionam como verbos: สวยไหม = 'está bonito?'; resposta: สวย. Sem 'ser'.", "en": "สวย and ดี behave like verbs: สวยไหม 'is it pretty?'; answer สวย."}, "ex": "สวย|sǔuai ไหม|mǎi"},
  {"t": {"pt": "Negação ไม่ e proibição อย่า", "en": "Negation ไม่ and prohibition อย่า"}, "e": {"pt": "ไม่ nega o verbo (ไม่เข้าใจ = não entendo); อย่า proíbe (อย่าเปิด = não abra). หน่อย no fim suaviza o pedido. Analogia: ไม่ é uma constatação, อย่า é uma placa de 'proibido'.", "en": "ไม่ negates (ไม่เข้าใจ); อย่า forbids (อย่าเปิด). หน่อย softens a request."}, "ex": "อย่า|yàa เปิด|bpə̀ət หน้าต่าง|nâa-dtàang"},
  {"t": {"pt": "เรียกว่า: como se chama", "en": "เรียกว่า: what it's called"}, "e": {"pt": "X เรียกว่า Y = 'X se chama Y'. Use para perguntar o nome tailandês de qualquer coisa: นี่เรียกว่าอะไร.", "en": "X เรียกว่า Y = X is called Y. Ask the Thai name of anything with นี่เรียกว่าอะไร."}, "ex": "นี่|nîi เรียกว่า|rîiak-wâa อะไร|à-rai"}
 ]}
